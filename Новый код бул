import os
import time
import telebot
from google import genai
from telebot.types import ReplyKeyboardMarkup

TOKEN = os.getenv("BOT_TOKEN")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
bot = telebot.TeleBot(TOKEN)
ai = genai.Client(api_key=GEMINI_KEY)

MODEL = "gemini-3.5-flash-lite"

SYSTEM_PROMPT = """
Сен CyberMind AI бағдарламашы көмекшісің.

- Python кодын жаз.
- Қателерді тап және түзет.
- Толық жұмыс істейтін код бер.
- Кодты толықтыр.
- Қазақша және орысша түсін.
- Код сұралса, тек код бер.
- Markdown қолданба.
"""

@bot.message_handler(commands=["start"])
def start(message):
    keyboard = ReplyKeyboardMarkup(resize_keyboard=True)
    keyboard.add("💻 Код жазу", "🛠 Кодты түзету")

    bot.send_message(
        message.chat.id,
        "CyberMind AI дайын! Тапсырмаңды жібер.",
        reply_markup=keyboard
    )

@bot.message_handler(func=lambda message: True)
def assistant(message):

    user_text = message.text

    if not user_text:
        return

    bot.send_chat_action(message.chat.id, "typing")

    try:
        answer = None

        for attempt in range(3):
            try:
                response = ai.models.generate_content(
                    model=MODEL,
                    contents=SYSTEM_PROMPT + "\n\n" + user_text
                )

                answer = response.text
                break

            except Exception as e:
                print("AI қатесі:", e)

                if "503" in str(e) and attempt < 2:
                    time.sleep(3 * (attempt + 1))
                else:
                    raise

        if not answer:
            raise Exception("AI бос жауап қайтарды")

        answer = answer.replace("```python", "")
        answer = answer.replace("```", "").strip()

        for i in range(0, len(answer), 4000):
            bot.send_message(
                message.chat.id,
                answer[i:i+4000]
            )

    except Exception as e:
        print("Толық қате:", repr(e))

        bot.send_message(
            message.chat.id,
            "AI қатесі:\n" + str(e)[:2500]
        )

print("CyberMind AI іске қосылды!")

bot.infinity_polling()
